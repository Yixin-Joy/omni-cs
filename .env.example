# ===== 微信伺服器配置（後台「伺服器配置」頁填的 Token）=====
WECHAT_TOKEN=你設定的token

# ===== 微信開發者 ID（下載語音/視頻 media 用；個人號權限需實測）=====
WECHAT_APPID=你的微信AppID
WECHAT_APPSECRET=你的微信AppSecret

# ===== 消息加解密方式：plain / compatible / safe（安全/兼容模式需填下面的 EncodingAESKey）=====
WECHAT_ENCRYPT_MODE=plain
WECHAT_ENCODING_AES_KEY=後台隨機生成的43字元AESKey（明文模式可留空）

# ===== 領導給的轉發目標 =====
TARGET_WEBHOOK_URL=https://你的轉發目標/webhook

# ===== 目標系統的 channel 標識（正式要問領導換成專屬值）=====
CHANNEL=epro-web
CHANNEL_IDENTITY_ID=你的channel identity id

# ===== 本服務對外可訪問的 https 基址（ngrok 產生的位址，去掉結尾斜線）=====
# 用途：語音/視頻下載後，url 指向 https://這個位址/files/xxx
PUBLIC_BASE_URL=https://xxxxxxxx.ngrok-free.app

# ===== 媒體檔落地目錄 =====
MEDIA_DIR=media

# ===== WhatsApp（Meta Cloud API）=====
# Meta 後台 webhook 驗證填的 verify token
WHATSAPP_VERIFY_TOKEN=你在Meta後台填的verify token

# Meta App 的 access token（下載 WhatsApp 媒體用）
WHATSAPP_ACCESS_TOKEN=你的Meta access token

# WhatsApp 的 Phone Number ID（發消息用，Meta 後台 WhatsApp > API Setup 可找到）
WHATSAPP_PHONE_NUMBER_ID=你的phone number id

# WhatsApp 渠道標識（正式要問領導換成專屬值）
WHATSAPP_CHANNEL=epro-web
WHATSAPP_CHANNEL_IDENTITY_ID=你的channel identity id

# Meta Graph API 版本
GRAPH_API_VERSION=v22.0

# ===== Facebook / Instagram（私訊 + 貼文留言）=====
# App 編號（App 後台 → 設定 → 基本資料）；token_tool.py 延長/衍生權杖時需要
META_APP_ID=
# Meta 後台 webhook 驗證 token（自行設定）
META_VERIFY_TOKEN=你在Meta後台填的verify token
# (選用) 驗證 webhook 簽章用的 App Secret
META_APP_SECRET=
# 是否驗證 webhook 簽章（true/false，預設 false）
META_VERIFY_SIGNATURE=false
# FB/IG 共用的 Graph API 版本
META_GRAPH_VERSION=v21.0
# IG 發送主機（留空 = 依 token 前綴自動判斷）
META_IG_GRAPH_HOST=
# Facebook 粉絲專頁 ID
META_PAGE_ID=
# 使用者權杖（type=USER，衍生粉專權杖用，程式不使用）
META_USER_ACCESS_TOKEN=
# 粉專權杖（FB 私訊/貼文留言、IG 貼文留言）
META_PAGE_ACCESS_TOKEN=
# Instagram 專業帳號 ID（FB 登入路徑的 ID）
META_IG_USER_ID=
# Instagram 登入路徑權杖（IGAA…，IG 私訊用）
META_IG_ACCESS_TOKEN=

# ===== 轉發日誌資料庫 =====
DATABASE_URL=postgresql://user:password@localhost:5432/platform_forwarder

# ===== AI 自動回復（DeepSeek）=====
# 你的 DeepSeek API Key，留空則第二層（業務表格匹配）與 FAQ 改寫停用，直接降級人工
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型 ID；本專案預設 deepseek-flash（也可用 deepseek-chat / deepseek-reasoner）
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT=30

# FAQ 改寫：off = 不呼叫 AI；on_miss = 規則未命中時才改寫問句再匹配一次
FAQ_REWRITE_MODE=on_miss
# FAQ 規則匹配門檻（0~1，越高越嚴格）
FAQ_MATCH_THRESHOLD=0.45

# 餵給模型的業務表格上限（列數 / 字元數，0 = 不限制）
TABLE_CONTEXT_MAX_ROWS=200
TABLE_CONTEXT_MAX_CHARS=12000

# 業務表格第一次查不到時：帶入最近 N 則對話讓模型改寫 query 再查一次（0 = 不改寫）
TABLE_REWRITE_HISTORY_TURNS=5

# 自動回復防護：同一會話冷卻秒數、每日每會話上限（0 = 不限制）
AUTOREPLY_COOLDOWN_SECONDS=30
AUTOREPLY_MAX_PER_DAY=30

# 以下幾組提示詞留空 = 用程式內建預設值（見 config.py）
# DEEPSEEK_SYSTEM_PROMPT=
# DEEPSEEK_COMMENT_PROMPT=
# DEEPSEEK_TABLE_PROMPT=
# DEEPSEEK_REWRITE_PROMPT=
# DEEPSEEK_TABLE_REWRITE_PROMPT=
