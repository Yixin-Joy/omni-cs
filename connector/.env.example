# ===== Connector 服務（純通道）=====
PORT=8010
INTERNAL_BIND_HOST=127.0.0.1

# Connector DB（渠道訊息）
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/platform_forwarder

# 媒體實體存儲
MEDIA_DIR=media
KB_CACHE_DIR=media/kb_cache
KB_CACHE_TTL_DAYS=7
# 對外可訪問基址（ngrok / 正式域名），拼媒體 URL 用
PUBLIC_BASE_URL=

# ===== 內網互通（與 CRM 共用同一把 token）=====
CRM_INTERNAL_BASE=http://127.0.0.1:8020
INTERNAL_API_TOKEN=change-me-shared-internal-token

# ===== 微信公眾號 =====
WECHAT_TOKEN=
WECHAT_APPID=
WECHAT_APPSECRET=
WECHAT_ENCRYPT_MODE=plain
WECHAT_ENCODING_AES_KEY=

# ===== WhatsApp（Meta Cloud API）=====
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_CHANNEL=epro-web
WHATSAPP_CHANNEL_IDENTITY_ID=

# ===== Facebook / Instagram =====
GRAPH_API_VERSION=v22.0
META_GRAPH_VERSION=v21.0
META_APP_ID=
META_VERIFY_TOKEN=
META_APP_SECRET=
META_VERIFY_SIGNATURE=false
# 留空 = 依 token 前綴自動判斷（IGAA… → graph.instagram.com）
META_IG_GRAPH_HOST=
META_PAGE_ID=
META_USER_ACCESS_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_IG_USER_ID=
# Instagram 登入路徑權杖（IGAA…）
META_IG_ACCESS_TOKEN=

# ===== 通道路由（渠道標識）=====
CHANNEL=epro-web
CHANNEL_IDENTITY_ID=

# ===== 任務派發 =====
# 不用 Redis：Connector 輪詢 CRM 的 claim API 拉取已認領任務。1 秒即可，體感無延遲。
POLL_SECONDS=1
# 保留設定項但留空；未來若真要亞秒級派發才填（輪詢永遠保留當兜底）。
REDIS_URL=

# ===== 背景 worker =====
# 關掉 = 不起任何背景迴圈（自檢 / 只想跑 webhook 時用）
WORKER_ENABLED=true
# 出站發送模式：live = 真的打平台 API；mock = 不發網路請求（自檢 / 演示）
OUTBOUND_SEND_MODE=live
# 帳號映射定時拉取兜底（秒）
ACCOUNT_MAP_SYNC_SECONDS=60
# 超過這個秒數沒成功同步 → 上報 account_map_stale 告警
ACCOUNT_MAP_STALE_SECONDS=300
