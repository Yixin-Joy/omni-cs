# ===== CRM 服務（大腦 + 資料 + 工作台）=====
PORT=8020
INTERNAL_BIND_HOST=127.0.0.1

# CRM DB
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/crm_db

# ===== 內網互通（與 Connector 共用同一把 token）=====
CONNECTOR_INTERNAL_BASE=http://127.0.0.1:8010
INTERNAL_API_TOKEN=change-me-shared-internal-token

# ===== Session / 登入安全 =====
SESSION_TTL_HOURS=8
SESSION_COOKIE_NAME=mcrm_sid
LOGIN_MAX_FAIL=5
LOGIN_LOCK_MINUTES=15

# ===== 媒體（知識庫圖片公開目錄）=====
RAG_MEDIA_DIR=media
RAG_MEDIA_URL_PREFIX=/media

# ===== AI 供應商（DeepSeek）=====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT=30
DEEPSEEK_AUX_TIMEOUT=5
DEEPSEEK_MAX_CONCURRENCY=2
DEEPSEEK_VISION_TIMEOUT=90

# FAQ 規則匹配門檻（0~1）
FAQ_MATCH_THRESHOLD=0.45

# 餵給模型的業務表格內容上限
TABLE_CONTEXT_MAX_ROWS=200
TABLE_CONTEXT_MAX_CHARS=12000
TABLE_REWRITE_HISTORY_TURNS=5

# 自動回復防護：同會話冷卻秒數 / 每日上限
AUTOREPLY_COOLDOWN_SECONDS=30
AUTOREPLY_MAX_PER_DAY=30

# ===== 背景 worker =====
# 關掉 = 不起逾時清理 / session 清理迴圈（自檢時用）
WORKER_ENABLED=true
AI_WORKER_POLL_SECONDS=1
# 逾時清理週期（秒）；任務 processing 超過 outbound.processing_timeout 才處理
TIMEOUT_SWEEP_SECONDS=60

# ===== Redis =====
# 第一版不裝 Redis：任務派發由 Connector 輪詢 claim API 完成（PG 行鎖保證不重派）。
# 保留設定項但留空。
REDIS_URL=

# 自檢腳本 crm/tests/auth_check.py 登入用（留空則需 --password）
CRM_ADMIN_PASSWORD=
