# 二進位檔（不要被當成文字做 diff / 自動合併）
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.pdf  binary
*.docx binary
*.xlsx binary
*.xls  binary
*.onnx binary
*.bin  binary
*.exe  binary
*.ttf  binary

# Windows 腳本用 CRLF，避免在某些工具下執行失敗
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
